TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather

# Optional settings
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210
# WORKERS=2
# QUEUE_SIZE=32
# MAX_LINKS_PER_MESSAGE=3
# MAX_FILE_SIZE_MB=49
# MAX_DOWNLOAD_SIZE_MB=250
# DOWNLOAD_TIMEOUT=4m
# DOWNLOAD_ATTEMPTS=3
# DOWNLOAD_RETRY_DELAY=2s
# COMPRESSION_TIMEOUT=12m
# UPLOAD_TIMEOUT=3m
# COMPRESS_OVERSIZED=true
# NOTIFY_ERRORS=true
# YT_DLP_COOKIES_FILE=/run/secrets/cookies.txt
# YT_DLP_YOUTUBE_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# TIKTOK_DEVICE_ID=7301234567890123456
# TIKTOK_PHOTO_HELPER_PATH=brsaver-tiktok-photos

# Voice message transcription (disabled until an API key is set).
# A free Groq key: https://console.groq.com/keys
# TRANSCRIPTION_API_KEY=gsk_replace-with-groq-key
# TRANSCRIPTION_API_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3
# TRANSCRIPTION_LANGUAGE=uk
# TRANSCRIPTION_PROMPT=
# TRANSCRIPTION_TIMEOUT=2m
# MAX_VOICE_DURATION=10m
